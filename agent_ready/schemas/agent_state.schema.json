{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fireagentbench.org/schemas/agent_state.schema.json",
  "title": "FireAgentBench private agent state",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "role_id", "split", "case_key", "messages", "memory_status"],
  "properties": {
    "session_id": {"type": "string", "minLength": 1},
    "role_id": {
      "type": "string",
      "enum": ["geo_agent", "fire_behavior_agent", "resource_history_agent", "critic_agent", "single_agent"]
    },
    "split": {"type": "string", "enum": ["train", "development", "validation", "test"]},
    "case_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["incident_id", "fire_day_date"],
      "properties": {
        "incident_id": {"type": "string"},
        "fire_day_date": {"type": "string", "format": "date"}
      }
    },
    "messages": {"type": "array", "items": {"type": "string"}},
    "reflection_memory": {"type": "array", "items": {"type": "string"}},
    "memory_status": {"type": "string", "enum": ["empty", "development_only", "frozen"]},
    "update_version": {"type": ["string", "null"]}
  }
}
