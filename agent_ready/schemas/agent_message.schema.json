{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fireagentbench.org/schemas/agent_message.schema.json",
  "title": "FireAgentBench inter-agent message",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message_id",
    "incident_id",
    "fire_day_date",
    "phase",
    "sender",
    "recipients",
    "message_type",
    "content",
    "evidence"
  ],
  "properties": {
    "message_id": {"type": "string", "minLength": 1},
    "incident_id": {"type": "string", "minLength": 1},
    "fire_day_date": {"type": "string", "format": "date"},
    "phase": {"type": "string", "enum": ["prediction", "scoring", "diagnosis", "update"]},
    "sender": {
      "type": "string",
      "enum": ["geo_agent", "fire_behavior_agent", "resource_history_agent", "critic_agent", "orchestrator"]
    },
    "recipients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["geo_agent", "fire_behavior_agent", "resource_history_agent", "critic_agent", "orchestrator"]
      }
    },
    "message_type": {
      "type": "string",
      "enum": ["evidence_report", "candidate_decision", "critique", "revision_request", "revision", "final_decision", "diagnosis", "update_proposal"]
    },
    "content": {"type": "string", "minLength": 1},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["view", "field"],
        "properties": {
          "view": {"type": "string"},
          "field": {"type": "string"},
          "value": {}
        }
      }
    }
  }
}
